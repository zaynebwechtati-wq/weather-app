# Copy to .env and edit as needed. Every value below is OPTIONAL —
# the app runs with these exact defaults if no .env file exists.

# Database. Defaults to a local SQLite file (no server to install).
# For PostgreSQL, uncomment and adapt:
# DATABASE_URL=postgresql://postgres:admin123@localhost:5432/weather_db
DATABASE_URL=sqlite:///./weather.db

# Station coordinates. Default is Tunis.
CITY_LAT=36.8065
CITY_LON=10.1815

# Open-Meteo needs no API key.

SECRET_KEY=ma_clef_secrete_123456
DEBUG=False
FORECAST_DAYS=7
